.venv/
__pycache__/
# model weights (original copied from LM Studio + edited GGUFs, ~800 MB each)
models/
# teacher-forced activations: ~160 MB, regenerated by collect_acts.py / neuron_stats.py
results/acts/*
# ...except the per-layer directions (100 KB), needed by write_gguf.py to rebuild the edited models
!results/acts/dirs.npz
# run logs
results/*.log
results/log_*.txt
